{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nutrileanin.vercel.app" }],
      "destination": "https://www.nutrilean.in/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/book.html", "destination": "/book", "permanent": true }
  ],
  "rewrites": [
    { "source": "/book", "destination": "/book.html" },
    { "source": "/experts/:name", "destination": "/experts/:name.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
